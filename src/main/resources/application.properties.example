server.port=8080

spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/greenbuilding?createDatabaseIfNotExist=true&serverTimezone=America/Bogota}
spring.datasource.username=${DB_USER:root}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false
spring.jackson.time-zone=America/Bogota

jwt.secret=${JWT_SECRET:cambiaEstaClaveSecretaDeGreenBuildingPorUnaLarga2026}

app.admin.username=${ADMIN_USERNAME:admin@greenbuilding.com}
app.admin.password=${ADMIN_PASSWORD:Admin12345*}
app.datos-ejemplo=${DATOS_EJEMPLO:true}
app.front.url=${FRONT_URL:http://localhost:4200}
app.correo.remitente=${CORREO_REMITENTE:no-responder@greenbuilding.com}
app.ruta.url=${RUTA_URL:https://routing.openstreetmap.de}
app.ruta.apikey=
app.ia.url=https://integrate.api.nvidia.com/v1/chat/completions
app.ia.modelo=nvidia/nemotron-3.5-bolt-e4b
app.ia.apikey=
app.ia.max-caracteres=500
app.ia.max-historial=6
app.ia.pausa-ms=1500

spring.mail.host=${MAIL_HOST:}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

springdoc.swagger-ui.path=/
springdoc.swagger-ui.docExpansion=none
springdoc.swagger-ui.syntaxHighlight.activated=true
springdoc.swagger-ui.syntaxHighlight.theme=markdown
springdoc.swagger-ui.displayRequestDuration=true
springdoc.swagger-ui.filter=true
springdoc.swagger-ui.tryItOutEnabled=true
springdoc.swagger-ui.supportedSubmitMethods=["get", "post", "put", "delete"]
springdoc.swagger-ui.disable-swagger-default-url=true
springdoc.swagger-ui.html-escaping.enabled=false
